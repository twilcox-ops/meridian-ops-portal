# Local development only — never commit a real .env (it's gitignored).
#
# In the deployed container, these same variable names are populated by the
# platform: Container App secretRefs pointing at Key Vault, resolved through
# a managed identity (see deploy/README.md). Application code only ever
# calls os.getenv — it never talks to Key Vault directly, and the .env file
# itself is never copied into the image (see deploy/Dockerfile).

# Postgres in the cloud; sqlite:///./local.db is fine for local dev.
# For local Postgres via deploy/docker-compose.local.yml:
#   DATABASE_URL=postgresql+psycopg2://portal:localdev@localhost:5432/ops_portal
DATABASE_URL=sqlite:///./local.db

# Session cookie signing — required by Starlette's SessionMiddleware.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Entra ID app registration (confidential client, auth-code flow).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# Where each upstream project's output artifact lives, for the
# integrations/ adapters to read.
PROJECT1_INGESTION_SOURCE=
PROJECT2_REVIEW_QUEUE_SOURCE=
PROJECT4_TRIAGE_SOURCE=
